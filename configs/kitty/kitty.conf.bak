# BEGIN_KITTY_THEME
confirm_os_window_close 0
#font_family SF-Mono
# font_family JetBrainsMono Nerd Font
#font_family Terminus
font_size 11

cursor_shape beam

# background_opacity 0.95
include font.conf
include theme.conf



# BEGIN_KITTY_FONTS
font_family      family="CaskaydiaCove Nerd Font"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS