#!/bin/bash

# Colors (replace with your color variables)
BG="#191724"
FG="#e0def4"
HIGHLIGHT="#9ccfd8"

# Command to run bemenu with your colors and settings
bemenu_run() {
    bemenu-run \
        --fn "Symbols Nerd Font 12" \
        --fb "$BG" --ff "$FG" \
        --nb "$BG" --nf "$FG" \
        --hb "$HIGHLIGHT" --hf "$BG" \
        --tb "$HIGHLIGHT" --tf "$BG" \
        --list 10 \
        --prompt "Run: "
}

bemenu_run
